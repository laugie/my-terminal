{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "types": [],
    "rootDir": "src",
    "outDir": "dist-test",
    "noEmit": false,
    "declaration": false,
    "sourceMap": false
  },
  "files": [
    "src/node-test.d.ts",
    "src/write-chunks.ts",
    "src/write-queue.ts",
    "src/write-chunks.test.ts",
    "src/write-queue.test.ts",
    "src/diagram.test.ts",
    "src/tabs.test.ts"
  ]
}
