{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-auth-status",
    "allow-auth-setup",
    "allow-auth-login",
    "allow-auth-settings",
    "allow-auth-set-lock",
    "allow-list-hosts",
    "allow-add-manual-host",
    "allow-remove-manual-host",
    "allow-load-topology",
    "allow-open-session",
    "allow-write-session",
    "allow-resize-session",
    "allow-close-session",
    "allow-ui-zoom-load",
    "allow-ui-zoom-set",
    "allow-appearance-load",
    "allow-appearance-set",
    "allow-clipboard-read-text",
    "allow-clipboard-write-text",
    "allow-remote-shell-run",
    "allow-close-prompt-shown",
    "allow-quit-confirmed"
  ]
}
