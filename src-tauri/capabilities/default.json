{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-list-hosts",
    "allow-add-manual-host",
    "allow-remove-manual-host",
    "allow-open-session",
    "allow-write-session",
    "allow-resize-session",
    "allow-close-session"
  ]
}
